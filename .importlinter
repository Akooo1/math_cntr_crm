[importlinter]
root_packages =
    apps
include_external_packages = True

# Module dependency direction (docs/SPEC.md 4.2). Higher layers may import lower ones,
# never the reverse. Modules separated by "|" sit on the same layer and must not import
# each other.
[importlinter:contract:layers]
name = Module layers
type = layers
layers =
    apps.demo
    apps.reports | apps.salaries | apps.telegram | apps.store
    apps.billing | apps.crm
    apps.students | apps.staff
    apps.settings
    apps.accounts
    apps.core
ignore_imports =
    apps.*.migrations.* -> apps.**
    apps.*.tests.** -> apps.**

# Domain packages hold pure money math: no Django, no database.
[importlinter:contract:pure-domain]
name = Domain packages are pure Python
type = forbidden
source_modules =
    apps.billing.domain
    apps.salaries.domain
    apps.staff.domain
    apps.store.domain
forbidden_modules =
    django
    apps.billing.models
    apps.billing.services
    apps.salaries.models
    apps.salaries.services
    apps.staff.models
    apps.staff.services
    apps.store.models
    apps.store.services
