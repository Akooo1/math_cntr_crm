# Scheduled jobs (supercronic, container TZ=Asia/Tashkent). All jobs are idempotent.
# Monthly charges: runs daily so a missed night is caught up the next day.
10 0 * * * python manage.py generate_monthly_charges
# Roll lesson calendars of open-ended groups forward.
20 0 * * * python manage.py generate_lessons
# Drop expired login sessions.
40 3 * * * python manage.py clearsessions
# Telegram (phase 8): the Direktor's morning summary, then debt reminders to parents.
30 9 * * * python manage.py telegram_send summary
0 10 * * * python manage.py telegram_send debts
# Database backup to the Direktor's Telegram (does nothing while the bot has no token).
30 2 * * * python manage.py backup_to_telegram --nightly-if-configured
# Early warnings (missed lessons, overdue debt, uncontacted leads): every 15 minutes.
*/15 * * * * python manage.py run_alerts
